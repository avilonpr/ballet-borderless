# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# Your Formspree form ID (e.g. xpwzgqbr).
# 1. Create a free account at https://formspree.io
# 2. Create a new form — set the notification email to romiballetborderless@gmail.com
# 3. Copy the form ID from your dashboard and paste it here.
# DO NOT use the NEXT_PUBLIC_ prefix — this must stay server-only.
FORMSPREE_ID=your_form_id_here
